<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Example.QueueSystem.Application\Example.QueueSystem.Application.csproj" />
    <ProjectReference Include="..\Example.QueueSystem.Domain\Example.QueueSystem.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the EF Core version the Npgsql 10.0.3 provider builds against; a newer
         Design package drags in a higher Microsoft.EntityFrameworkCore and the assembly
         versions stop unifying. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

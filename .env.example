# Copy to .env and set a password before running `docker compose up`.
# .env is gitignored; this example file is not.
POSTGRES_PASSWORD=change-me

# Host port the containerized PostgreSQL is published on. Only needed by the
# integration tests and by psql — the app itself reaches the database over the
# compose network. Change it if 15432 is already taken on your machine.
POSTGRES_HOST_PORT=15432
